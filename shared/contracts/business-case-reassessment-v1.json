{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Reviewed case event reassessment request v1",
  "type":"object","additionalProperties":false,
  "required":["request_key","expected_revision","source","event_id","input_bindings"],
  "properties":{
    "request_key":{"type":"string","minLength":8,"maxLength":128},
    "expected_revision":{"type":"integer","minimum":1},
    "source":{"type":"string","minLength":1,"maxLength":128},
    "event_id":{"type":"string","minLength":1,"maxLength":128},
    "input_bindings":{"type":"object","minProperties":1,"maxProperties":32,"additionalProperties":{"type":"string","maxLength":512}}
  }
}
