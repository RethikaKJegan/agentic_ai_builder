{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-ai-builder.local/contracts/investigation-assessment-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "rationale",
    "action_id",
    "proposal",
    "input_requests",
    "assessment"
  ],
  "properties": {
    "decision": {
      "enum": [
        "continue",
        "retrieve_more",
        "replan",
        "request_input",
        "complete",
        "blocked"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "action_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "proposal": {
      "type": [
        "object",
        "null"
      ]
    },
    "input_requests": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "schema",
          "reason"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "schema": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "requirements",
        "findings",
        "gaps",
        "source_limitations",
        "invalid_assumptions",
        "recoverable_failures",
        "rule_evaluations",
        "completion_eligible"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "status",
              "evidence_ids"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "status": {
                "enum": [
                  "verified",
                  "unsatisfied",
                  "unsupported"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "path",
              "value",
              "classification"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "maxLength": 200
              },
              "path": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              },
              "value": {},
              "classification": {
                "enum": [
                  "observation",
                  "correlation"
                ]
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "blocking"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 160
              },
              "description": {
                "type": "string",
                "maxLength": 1000
              },
              "blocking": {
                "type": "boolean"
              }
            }
          }
        },
        "source_limitations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "invalid_assumptions": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "recoverable_failures": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "rule_evaluations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "scope",
              "source_ref",
              "inputs",
              "result",
              "missing_prerequisites",
              "version",
              "classification"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 160
              },
              "scope": {
                "type": "string",
                "maxLength": 500
              },
              "source_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "inputs": {
                "type": "object"
              },
              "result": {
                "type": "string",
                "maxLength": 1000
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "missing_prerequisites": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "classification": {
                "enum": [
                  "verified_policy",
                  "user_threshold",
                  "scenario_only",
                  "missing_policy"
                ]
              }
            }
          }
        },
        "completion_eligible": {
          "type": "boolean"
        },
        "calculations": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "operation",
              "operands",
              "result"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "operation": {
                "enum": [
                  "difference",
                  "ratio"
                ]
              },
              "operands": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidence_id",
                    "path"
                  ],
                  "properties": {
                    "evidence_id": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "path": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": [
                          "string",
                          "integer"
                        ]
                      }
                    }
                  }
                }
              },
              "result": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    }
  }
}
