{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "database-workflow-v1",
  "title": "Database workflow scope and tool boundaries v1",
  "$defs": {
    "values": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean",
          "null"
        ],
        "maxLength": 4096
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "subject_id",
        "connection_id",
        "dataset_id",
        "identity_fields",
        "writable_fields",
        "operations"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "connection_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "identity_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "writable_fields": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "create",
              "read",
              "update",
              "delete"
            ]
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "dataset_id",
        "action",
        "identity",
        "values",
        "unset_fields"
      ],
      "properties": {
        "connection_id": {
          "type": "string"
        },
        "dataset_id": {
          "type": "string"
        },
        "action": {
          "enum": [
            "create",
            "update",
            "delete"
          ]
        },
        "identity": {
          "$ref": "#/$defs/values"
        },
        "values": {
          "$ref": "#/$defs/values"
        },
        "unset_fields": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "dataset_id",
        "identity"
      ],
      "properties": {
        "connection_id": {
          "type": "string"
        },
        "dataset_id": {
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/values"
        }
      }
    },
    "execute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirm"
      ],
      "properties": {
        "confirm": {
          "const": true
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "state",
        "created_at",
        "expires_at",
        "recovery_until",
        "recovery_of",
        "recovery_operation_id",
        "steps",
        "preview_available"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^dbop_[a-f0-9]{32}$"
        },
        "state": {
          "enum": [
            "prepared",
            "running",
            "succeeded",
            "failed",
            "partial",
            "uncertain",
            "expired"
          ]
        },
        "created_at": {
          "type": "number"
        },
        "expires_at": {
          "type": "number"
        },
        "recovery_until": {
          "type": "number"
        },
        "recovery_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "recovery_operation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview_available": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "connection_id",
              "dataset_id",
              "label",
              "tool_id",
              "state",
              "matched_records",
              "affected_records",
              "error_code"
            ],
            "properties": {
              "action": {
                "enum": [
                  "create",
                  "update",
                  "delete"
                ]
              },
              "connection_id": {
                "type": "string"
              },
              "dataset_id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "tool_id": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "pending",
                  "running",
                  "succeeded",
                  "failed",
                  "uncertain"
                ]
              },
              "matched_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "affected_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "error_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "identity": {
                "type": "object"
              },
              "values": {
                "type": "object"
              },
              "unset_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "before": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "after": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        },
        "correlation_id": {
          "type": "string"
        },
        "contract_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured",
        "targets",
        "items",
        "tools"
      ],
      "properties": {
        "correlation_id": {
          "type": "string"
        },
        "contract_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "configured": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "connection_id",
              "dataset_id",
              "label",
              "engine",
              "identity_fields",
              "writable_fields",
              "operations"
            ],
            "properties": {
              "connection_id": {
                "type": "string"
              },
              "dataset_id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "engine": {
                "enum": [
                  "postgresql",
                  "mongodb"
                ]
              },
              "identity_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "writable_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "operations": {
                "type": "array",
                "items": {
                  "enum": [
                    "create",
                    "read",
                    "update",
                    "delete"
                  ]
                }
              }
            }
          }
        },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool_id",
              "provider_id",
              "capability",
              "approval_required"
            ],
            "properties": {
              "tool_id": {
                "type": "string"
              },
              "provider_id": {
                "type": "string"
              },
              "capability": {
                "type": "string"
              },
              "approval_required": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "read_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "matched_records",
        "label"
      ],
      "properties": {
        "correlation_id": {
          "type": "string"
        },
        "contract_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/values"
            },
            {
              "type": "null"
            }
          ]
        },
        "matched_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "label": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "dataset_id",
        "label",
        "engine",
        "context_hash"
      ],
      "properties": {
        "connection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "label": {
          "type": "string",
          "maxLength": 1024
        },
        "engine": {
          "enum": [
            "postgresql",
            "mongodb"
          ]
        },
        "context_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "graph_hash"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "graph_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "query_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan"
      ],
      "properties": {
        "plan": {
          "type": "object",
          "properties": {
            "base_dataset_id": {
              "type": "string",
              "maxLength": 200
            },
            "joins": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "relationship_id": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "target_dataset_id": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": [
                  "relationship_id",
                  "target_dataset_id"
                ],
                "additionalProperties": false
              },
              "maxItems": 3
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "maxItems": 30
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field_id": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "op": {
                    "enum": [
                      "eq",
                      "ne",
                      "gt",
                      "gte",
                      "lt",
                      "lte",
                      "is_null",
                      "not_null"
                    ]
                  },
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ],
                    "maxLength": 500
                  }
                },
                "required": [
                  "field_id",
                  "op",
                  "value"
                ],
                "additionalProperties": false
              },
              "maxItems": 20
            },
            "group_by": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "maxItems": 10
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "op": {
                    "enum": [
                      "count",
                      "sum",
                      "avg",
                      "min",
                      "max"
                    ]
                  },
                  "expression": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": [
                  "label",
                  "op",
                  "expression"
                ],
                "additionalProperties": false
              },
              "maxItems": 10
            },
            "order_by": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "direction": {
                    "enum": [
                      "asc",
                      "desc"
                    ]
                  }
                },
                "required": [
                  "column",
                  "direction"
                ],
                "additionalProperties": false
              },
              "maxItems": 5
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "explanation": {
              "type": "string",
              "maxLength": 2000
            },
            "clarification": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "base_dataset_id",
            "joins",
            "fields",
            "filters",
            "group_by",
            "metrics",
            "order_by",
            "limit",
            "explanation",
            "clarification"
          ],
          "additionalProperties": false
        }
      }
    },
    "execute_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^dbop_[a-f0-9]{32}$"
        }
      }
    },
    "read_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "matched_records",
        "sources"
      ],
      "properties": {
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/values"
            },
            {
              "type": "null"
            }
          ]
        },
        "matched_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "connection_id",
              "dataset_id",
              "label",
              "engine",
              "context_hash"
            ],
            "properties": {
              "connection_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "dataset_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "maxLength": 1024
              },
              "engine": {
                "enum": [
                  "postgresql",
                  "mongodb"
                ]
              },
              "context_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "operation_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "state",
        "steps",
        "sources"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "enum": [
            "prepared",
            "running",
            "succeeded",
            "failed",
            "partial",
            "uncertain",
            "expired"
          ]
        },
        "steps": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "connection_id",
              "dataset_id",
              "state",
              "matched_records",
              "affected_records",
              "error_code"
            ],
            "properties": {
              "action": {
                "enum": [
                  "create",
                  "update",
                  "delete"
                ]
              },
              "connection_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "dataset_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "state": {
                "type": "string"
              },
              "matched_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "affected_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "error_code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "connection_id",
              "dataset_id",
              "label",
              "engine",
              "context_hash"
            ],
            "properties": {
              "connection_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "dataset_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "maxLength": 1024
              },
              "engine": {
                "enum": [
                  "postgresql",
                  "mongodb"
                ]
              },
              "context_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "query_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "rows",
        "total_result_rows",
        "limited",
        "sources",
        "join_checks",
        "execution",
        "warnings"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object"
          }
        },
        "total_result_rows": {
          "type": "integer"
        },
        "limited": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "join_checks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "execution": {
          "type": "object"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$ref": "#/$defs/scope"
}
