{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_contracts",
    "client_id",
    "concepts",
    "domain",
    "evidence_requirements",
    "ontology_version",
    "package_id",
    "relationships",
    "resource_bindings",
    "revision",
    "rules",
    "source_mappings",
    "validation_requirements"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ontology_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "parent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "predicate"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "predicate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "source_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "concept",
          "source",
          "field"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "concept": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "mapping_id"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "mapping_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "capability_contracts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "capability_id",
          "supported_operation",
          "business_purpose",
          "kind",
          "input_schema",
          "output_schema",
          "required_ontology",
          "required_evidence",
          "preconditions",
          "allowed_tool_operations",
          "side_effect",
          "verification_method",
          "completion_criteria",
          "domain_scope",
          "retrieval_task"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "capability-contract-v1"
          },
          "capability_id": {
            "type": "string"
          },
          "supported_operation": {
            "type": "string"
          },
          "business_purpose": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "model",
              "tool"
            ]
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "required_ontology": {
            "type": "array"
          },
          "required_evidence": {
            "type": "array"
          },
          "preconditions": {
            "type": "array"
          },
          "allowed_tool_operations": {
            "type": "array"
          },
          "side_effect": {
            "type": "string",
            "enum": [
              "none",
              "read",
              "draft",
              "write"
            ]
          },
          "verification_method": {
            "type": "string"
          },
          "completion_criteria": {
            "type": "array"
          },
          "domain_scope": {
            "type": "array"
          },
          "retrieval_task": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "operator",
          "left_mapping",
          "right_mapping"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "operator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "left_mapping": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "right_mapping": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "resource_bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "source_id",
          "mapping_ids"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "mapping_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "validation_requirements": {
      "type": "array",
      "items": {
        "enum": [
          "acyclic_dependencies",
          "mapped_evidence",
          "current_source_authority"
        ]
      }
    },
    "process_definitions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:builder:business-lifecycle:v1",
        "title": "Versioned business process definition",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "process_definition_id",
          "version",
          "client_id",
          "domain_id",
          "stages"
        ],
        "properties": {
          "process_definition_id": {
            "$ref": "#/$defs/id"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "client_id": {
            "$ref": "#/$defs/id"
          },
          "domain_id": {
            "$ref": "#/$defs/id"
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "$ref": "#/$defs/stage"
            }
          }
        },
        "$defs": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "predicate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "path",
              "operator"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "operator": {
                "enum": [
                  "eq",
                  "ne",
                  "exists",
                  "gt",
                  "lt",
                  "in"
                ]
              },
              "value": {}
            }
          },
          "binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "path"
            ],
            "properties": {
              "source": {
                "type": "string",
                "description": "user, config, evidence, event or stage:<instance_id>"
              },
              "path": {
                "type": "string",
                "maxLength": 512
              }
            }
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema"
            ],
            "properties": {
              "schema": {
                "type": "object"
              },
              "binding": {
                "$ref": "#/$defs/binding"
              },
              "evidence_mapping": {
                "type": "string"
              },
              "derivation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operation",
                  "inputs"
                ],
                "properties": {
                  "operation": {
                    "enum": [
                      "copy",
                      "sum",
                      "difference",
                      "concat",
                      "days_between"
                    ]
                  },
                  "inputs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/binding"
                    }
                  }
                }
              },
              "inference": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "basis",
                  "value",
                  "explanation"
                ],
                "properties": {
                  "basis": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/binding"
                    }
                  },
                  "value": {},
                  "explanation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "synthetic_fallback": {
                "type": "boolean"
              },
              "fallback_value": {},
              "protected_activity": {
                "type": "boolean",
                "description": "Approvals, physical activities and connector receipts cannot be generated."
              },
              "policy": {
                "type": "boolean"
              }
            }
          },
          "wait": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_type",
              "expected_source",
              "correlation_keys",
              "schema",
              "requires_authorization"
            ],
            "properties": {
              "event_type": {
                "$ref": "#/$defs/id"
              },
              "expected_source": {
                "$ref": "#/$defs/id"
              },
              "correlation_keys": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "$ref": "#/$defs/binding"
                }
              },
              "schema": {
                "type": "object"
              },
              "requires_authorization": {
                "type": "boolean"
              },
              "blocking": {
                "type": "boolean",
                "default": true,
                "description": "False permits qualified analytical completion while the real event remains pending; never grants action authorization."
              }
            }
          },
          "stage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage_definition_id",
              "stage_instance_id",
              "version",
              "name",
              "description",
              "domain",
              "required_capabilities",
              "required_ontology_concepts",
              "required_inputs",
              "optional_inputs",
              "output_schema",
              "output_bindings",
              "dependency_definitions",
              "preconditions",
              "allowed_tools",
              "side_effect_classification",
              "completion_criteria",
              "transition_rules",
              "timeout_policy",
              "retry_policy",
              "external_event_requirements",
              "evidence_requirements",
              "provisional_continuation_policy"
            ],
            "properties": {
              "stage_definition_id": {
                "$ref": "#/$defs/id"
              },
              "stage_instance_id": {
                "$ref": "#/$defs/id"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "required_capabilities": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "required_ontology_concepts": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "required_inputs": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/input"
                }
              },
              "optional_inputs": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/input"
                }
              },
              "output_schema": {
                "type": "object"
              },
              "output_bindings": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/binding"
                }
              },
              "dependency_definitions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "preconditions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/predicate"
                }
              },
              "allowed_tools": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "side_effect_classification": {
                "enum": [
                  "none",
                  "read",
                  "draft",
                  "write"
                ]
              },
              "completion_criteria": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/predicate"
                }
              },
              "transition_rules": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/predicate"
                },
                "description": "All predicates must hold; false skips this branch."
              },
              "timeout_policy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "seconds",
                  "action"
                ],
                "properties": {
                  "seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31536000
                  },
                  "action": {
                    "enum": [
                      "block",
                      "fail",
                      "escalate",
                      "continue_provisionally"
                    ]
                  }
                }
              },
              "retry_policy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "max_retries",
                  "backoff_seconds"
                ],
                "properties": {
                  "max_retries": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "backoff_seconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 86400
                  }
                }
              },
              "external_event_requirements": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "$ref": "#/$defs/wait"
                }
              },
              "evidence_requirements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "provisional_continuation_policy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "allowed"
                ],
                "properties": {
                  "allowed": {
                    "type": "boolean"
                  },
                  "allow_event_timeout": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "memory_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "max_recommendations",
        "retention_seconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_recommendations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "retention_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped client knowledge and lifecycle package v1"
}
