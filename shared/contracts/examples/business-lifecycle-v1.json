        "policy": {
          "schema": {"type": "object", "required": ["statement"], "properties": {"statement": {"type": "string"}}},
          "binding": {"source": "config", "path": "analytical_policy"}, "policy": true,
          "synthetic_fallback": true,
          "fallback_value": {"statement": "No authoritative policy is available. This assumption supports analysis only and grants no commercial authorization."}
        }
      },
      "optional_inputs": {},
      "output_schema": {"type": "object", "required": ["policy"], "properties": {"policy": {"type": "object"}}},
