      "external_event_requirements": [], "evidence_requirements": [], "provisional_continuation_policy": {"allowed": true}
    },
    {
      "stage_definition_id": "inspection_analysis", "stage_instance_id": "inspection", "version": 1,
      "name": "Await inspection report or qualify analytical continuation", "description": "An analytical placeholder never records that a physical inspection occurred.", "domain": "field-service",
      "required_capabilities": [], "required_ontology_concepts": [],
