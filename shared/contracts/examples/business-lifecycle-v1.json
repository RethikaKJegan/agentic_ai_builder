        "policy": {"schema": {"type": "object"}, "binding": {"source": "stage:policy", "path": "policy"}},
        "findings": {"schema": {"type": "string"}, "binding": {"source": "event", "path": "findings"}, "synthetic_fallback": true, "fallback_value": "Inspection findings unavailable; analytical placeholder only."}
