  "conditions": [],
  "approval_gates": [],
  "execution_policy": {"limits": {"max_llm_calls": 2, "max_tool_calls": 3, "max_tokens": 3000, "max_retries": 1, "timeout_seconds": 180, "max_estimated_cost_usd": 0.3}, "requires_review_before_execution": true, "allow_external_writes": true},
