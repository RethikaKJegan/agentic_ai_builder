{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-ai-builder.local/contracts/evaluator-decision-v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "evaluator-decision-v1"
    },
    "decision": {
      "enum": [
        "continue",
        "gather_context",
        "revise_plan",
        "request_input",
        "wait_for_event",
        "complete"
      ]
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "observation_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 1
    },
    "action_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 1
    },
    "completion_criteria": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "proposal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object"
              }
            },
            "completion_criteria": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "missing_inputs": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          },
          "required": [
            "actions",
            "completion_criteria",
            "missing_inputs"
          ]
        }
      ]
    },
    "input_requests": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "schema": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "key",
          "schema",
          "reason"
        ]
      }
    },
    "event_request": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "event_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "expected_source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "schema": {
              "type": "object"
            },
            "deadline_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          },
          "required": [
            "event_type",
            "expected_source",
            "schema",
            "deadline_seconds"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "decision",
    "plan_revision",
    "observation_ids",
    "action_ids",
    "completion_criteria",
    "rationale",
    "proposal",
    "input_requests",
    "event_request"
  ]
}
