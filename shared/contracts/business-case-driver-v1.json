{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded business-case driver request v1",
  "type": "object", "additionalProperties": false, "required": ["request_key"],
  "properties": {
    "request_key": {"type": "string", "minLength": 8, "maxLength": 128},
    "max_commands": {"type": "integer", "minimum": 1, "maximum": 64, "default": 32},
    "max_seconds": {"type": "integer", "minimum": 1, "maximum": 600, "default": 120},
    "max_stage_executions": {"type": "integer", "minimum": 1, "maximum": 256, "default": 64},
    "resume": {"type": "boolean", "default": false}
  }
}
