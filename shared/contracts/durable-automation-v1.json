{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-ai-builder.local/contracts/durable-automation-v1.json",
  "oneOf": [
    {
      "$ref": "#/$defs/subscription"
    },
    {
      "$ref": "#/$defs/schedule"
    },
    {
      "$ref": "#/$defs/authorization"
    },
    {
      "$ref": "#/$defs/timer"
    },
    {
      "$ref": "#/$defs/control"
    },
    {
      "$ref": "#/$defs/record"
    }
  ],
  "$defs": {
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workflow_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "workflow_version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "workflow_id",
            "workflow_version"
          ]
        },
        "authorization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cron": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "missed_run_policy": {
          "enum": [
            "skip",
            "coalesce",
            "catch_up"
          ]
        },
        "overlap_policy": {
          "enum": [
            "forbid",
            "allow"
          ]
        },
        "inputs": {
          "type": "object"
        }
      },
      "required": [
        "request_key",
        "workflow",
        "authorization_id",
        "cron",
        "timezone",
        "missed_run_policy",
        "overlap_policy",
        "inputs"
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "connection_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "operations": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": {
            "type": "object"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "content_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "schedule": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cron": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "cron",
                "timezone"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "event_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "provider",
                "source_id",
                "event_type",
                "timezone"
              ]
            }
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_occurrences": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "max_actions_per_occurrence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            }
          },
          "required": [
            "max_occurrences",
            "max_actions_per_occurrence"
          ]
        },
        "expires_at": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "request_key",
        "connection_id",
        "operations",
        "purpose",
        "content_scope",
        "schedule",
        "limits",
        "expires_at"
      ]
    },
    "timer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "wait_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "stage_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "due": {
          "type": "number",
          "minimum": 0
        },
        "purpose": {
          "enum": [
            "follow_up",
            "reply_deadline",
            "approval_deadline",
            "escalation",
            "delayed_continuation",
            "retry_after"
          ]
        }
      },
      "required": [
        "request_key",
        "case_id",
        "wait_id",
        "stage_id",
        "due",
        "purpose"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "enum": [
            "pause",
            "resume",
            "cancel",
            "revoke",
            "replace",
            "retry"
          ]
        },
        "replacement_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "request_key",
        "action"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "replace"
              }
            }
          },
          "then": {
            "required": [
              "replacement_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "replacement_id"
              ]
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "required": [
        "schema_version",
        "workspace_id",
        "owner_id",
        "id",
        "kind",
        "state"
      ],
      "properties": {
        "schema_version": {
          "const": "durable-automation-v1"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "subscription",
            "schedule",
            "authorization",
            "timer",
            "occurrence",
            "control"
          ]
        },
        "state": {
          "enum": [
            "active",
            "queued",
            "running",
            "waiting",
            "completed",
            "failed",
            "cancelled",
            "revoked",
            "paused",
            "expired",
            "dead_letter",
            "requires_reconciliation"
          ]
        }
      }
    },
    "case_subscription": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "wait_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "stage_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "connection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "correlation": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254
          }
        },
        "expected_information": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "payload_mapping": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "deadline": {
          "type": "number",
          "minimum": 0
        },
        "poll_workflow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workflow_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "workflow_version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "workflow_id",
            "workflow_version"
          ]
        }
      },
      "required": [
        "request_key",
        "case_id",
        "wait_id",
        "stage_id",
        "provider",
        "connection_id",
        "correlation",
        "participants",
        "expected_information",
        "payload_mapping",
        "deadline",
        "poll_workflow"
      ]
    },
    "subscription": {
      "oneOf": [
        {
          "$ref": "#/$defs/case_subscription"
        },
        {
          "$ref": "#/$defs/workflow_subscription"
        }
      ]
    },
    "workflow_subscription": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workflow_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "workflow_version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "workflow_id",
            "workflow_version"
          ]
        },
        "authorization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "event_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "conditions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "op": {
                "enum": [
                  "eq",
                  "ne",
                  "gt",
                  "gte",
                  "lt",
                  "lte"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "path",
              "op",
              "value"
            ]
          }
        },
        "inputs": {
          "type": "object"
        },
        "expires_at": {
          "type": "number",
          "minimum": 0
        },
        "overlap_policy": {
          "enum": [
            "allow",
            "forbid"
          ]
        }
      },
      "required": [
        "request_key",
        "workflow",
        "authorization_id",
        "provider",
        "source_id",
        "event_type",
        "conditions",
        "inputs",
        "expires_at",
        "overlap_policy"
      ]
    }
  }
}
