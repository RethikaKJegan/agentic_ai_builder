# Placeholders only; real values belong in the ignored .env.
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=REPLACE_ME
# Live workflow launcher: comma-separated operator-approved email recipients.
BUILDER_EMAIL_RECIPIENTS=REPLACE_ME
# Opt in to automatic email for workflows with no action-approval gate.
BUILDER_EMAIL_DIRECT_SEND=0
# Automatic customer reply processing also needs inbox monitoring.
BUILDER_REPLY_MONITOR=0
# Optional manager override; must be in BUILDER_EMAIL_RECIPIENTS.
# BUILDER_CASE_BOSS_EMAIL=manager@example.com
# Optional operator restriction, not needed for prompt-selected spreadsheets.
# Empty means reviewed workflow metadata defines the allowed destinations.
BUILDER_SHEETS_WRITE_TARGETS=
# Separate opt-in for reviewed automatic sheet writes; otherwise action approval.
BUILDER_SHEETS_DIRECT_WRITE=0
# Bounded generation deadline (30-300 seconds); runtime call limits are separate.
BUILDER_PLANNER_TIMEOUT_SECONDS=180
# Optional exact model rates JSON (USD per token) and tokenizer name.
# gpt-5.6-luna standard short-context rates are built into the launcher.
BUILDER_MODEL_RATES=
BUILDER_MODEL_TOKENIZER=
OPEN_METEO_BASE_URL=REPLACE_ME
OPEN_METEO_LATITUDE=REPLACE_ME
OPEN_METEO_LONGITUDE=REPLACE_ME
OPEN_LIBRARY_BASE_URL=REPLACE_ME
REST_API_BASE_URL=REPLACE_ME
REST_API_AUTH_MODE=REPLACE_ME
GITHUB_API_BASE_URL=REPLACE_ME
GITHUB_TOKEN=REPLACE_ME
GITHUB_TEST_REPOSITORY=REPLACE_ME
SLACK_WEBHOOK_URL=REPLACE_ME
GMAIL_SMTP_HOST=REPLACE_ME
GMAIL_SMTP_PORT=REPLACE_ME
GMAIL_SMTP_USER=REPLACE_ME
GMAIL_SMTP_PASSWORD=REPLACE_ME
BREVO_SMTP_HOST=REPLACE_ME
BREVO_SMTP_PORT=REPLACE_ME
BREVO_SMTP_USER=REPLACE_ME
BREVO_SMTP_PASSWORD=REPLACE_ME
GOOGLE_CLOUD_PROJECT_ID=REPLACE_ME
GOOGLE_CREDENTIALS_FILE=REPLACE_ME
GOOGLE_TOKEN_FILE=REPLACE_ME
GOOGLE_OAUTH_SCOPES=REPLACE_ME
GOOGLE_SHEETS_SPREADSHEET_ID=REPLACE_ME
GOOGLE_DOCS_DOCUMENT_ID=REPLACE_ME
GOOGLE_CALENDAR_ID=REPLACE_ME
WEBHOOK_HOST=REPLACE_ME
WEBHOOK_PORT=REPLACE_ME
WEBHOOK_PATH=REPLACE_ME
WEBHOOK_SECRET=REPLACE_ME
# Local UI/API POC only. No provider credentials belong in frontend variables.
BUILDER_DEV_AUTH=0
BUILDER_DEV_ROLES=builder
BUILDER_UI_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional repository-local, operator-owned registry JSON. Empty = unconfigured.
BUILDER_REGISTRY_CONFIG=

# Slack Socket Mode app-level token (connections:write); enter via hidden prompt.
SLACK_APP_TOKEN=

# Integrate reviewed procurement connectors into the existing MESH backend.
BUILDER_PROCUREMENT_ENABLED=0
# Allows new explicitly reviewed automatic-mode procurement workflows.
BUILDER_PROCUREMENT_AUTOMATIC=0
BUILDER_PROCUREMENT_CONFIG=.local/connector-extension/config.json
BUILDER_PROCUREMENT_GOOGLE_TOKEN=.local/connector-extension/google-token.json
