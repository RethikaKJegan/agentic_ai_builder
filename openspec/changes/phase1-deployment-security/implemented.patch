+
+    def loop(self):
+        while not self.stop_event.is_set():
+            try:
+                worked = self.tick()
+            except Exception:
+                import logging
+                logging.getLogger(__name__).warning('Planning queue unavailable; durable jobs retained.')
+                worked = False
+            if not worked:
+                self.wake.wait(1)
+                self.wake.clear()
+
+    def stop(self):
+        self.stop_event.set()
+        self.wake.set()
+        if self.thread:
+            self.thread.join(timeout=1)
