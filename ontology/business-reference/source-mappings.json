    {
      "collection": "oemnames",
      "label": "OEM organization",
      "role": "service",
      "fields": [
        "_id",
        "name"
      ]
    },
    {
      "collection": "oems",
      "label": "OEM account",
      "role": "service",
      "fields": [
        "_id",
        "oemNameId"
      ]
    },
    {
      "collection": "enginedetails",
